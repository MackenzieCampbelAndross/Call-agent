<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Purple outline -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/login_otp_cell_bg" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/login_otp_focused_stroke" />
        </shape>
    </item>
    <!-- Normal state: Soft background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/login_otp_cell_bg" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
