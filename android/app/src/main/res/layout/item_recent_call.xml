<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <!-- Direction / Outcome Glyph -->
    <ImageView
        android:id="@+id/ivCallIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_phone_filled" />

    <!-- Name & Meta Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPrimaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1 (415) 555-0199"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCallMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outgoing • 00:45"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSyncDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="• Synced"
                android:textColor="@color/accent_purple"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="14:22"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Info / Details Action -->
    <ImageView
        android:id="@+id/btnCallDetails"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_info_circle" />

</LinearLayout>
