<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Top SIM Selection Badge / Info -->
    <LinearLayout
        android:id="@+id/btnSimSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvActiveSimLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM 1 (Cellular)"
            android:textColor="@color/accent_purple"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Inline Matching Contact Suggestion Container -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKeypadSuggestions"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:visibility="invisible" />

    <!-- Large Elegant Number Display with Backspace -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/tvDialerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:hint=""
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnDialerBackspace"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_backspace_apple"
            android:visibility="invisible" />
    </RelativeLayout>

    <!-- Balanced 12-Key Numeric Keypad Grid -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Row 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 1 -->
            <LinearLayout
                android:id="@+id/key1"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 2 ABC -->
            <LinearLayout
                android:id="@+id/key2"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A B C"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3 DEF -->
            <LinearLayout
                android:id="@+id/key3"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D E F"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 4 GHI -->
            <LinearLayout
                android:id="@+id/key4"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G H I"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 5 JKL -->
            <LinearLayout
                android:id="@+id/key5"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="J K L"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 6 MNO -->
            <LinearLayout
                android:id="@+id/key6"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M N O"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 7 PQRS -->
            <LinearLayout
                android:id="@+id/key7"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P Q R S"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 8 TUV -->
            <LinearLayout
                android:id="@+id/key8"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T U V"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 9 WXYZ -->
            <LinearLayout
                android:id="@+id/key9"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="W X Y Z"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 4: *, 0, # -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- * -->
            <LinearLayout
                android:id="@+id/keyStar"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp" />
            </LinearLayout>

            <!-- 0 + -->
            <LinearLayout
                android:id="@+id/key0"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- # -->
            <LinearLayout
                android:id="@+id/keyHash"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Call Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <FrameLayout
                android:id="@+id/btnInitiateCall"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_call_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone_filled" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
